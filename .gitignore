# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database (contains real trainee data — never commit)
/prisma/*.db
/prisma/*.db-journal

# Real roster data — contains staff emails and initial passwords
people.csv

# Database copies made for sharing/migration — real trainee PII, never commit
/exports/


# ...but the template with no secrets in it must ship, or a fresh clone has no reference
# for what to set. HANDOFF §2 tells you to copy it.
!.env.example
